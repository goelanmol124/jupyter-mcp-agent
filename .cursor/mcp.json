{
  "mcpServers": {
    "llm-jupyter-project": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "llm_jupyter",
        "serve",
        "-n",
        "demos/rnd_benchmark_2026/analysis_mcp.ipynb",
        "--roots",
        "."
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "LLM_JUPYTER_ROOTS": "${workspaceFolder}",
        "LLM_JUPYTER_PROCESS_CWD": "${workspaceFolder}"
      }
    }
  }
}
