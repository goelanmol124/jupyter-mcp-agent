{
  "companion_version": 1,
  "notebook": "agent_demo_markov.ipynb",
  "cells": [
    {
      "cell_id": "11111111-1111-4111-8111-111111116001",
      "source": "import numpy as np\nrng = np.random.default_rng(17)\n"
    },
    {
      "cell_id": "11111111-1111-4111-8111-111111116002",
      "source": "P = np.array([[0.92, 0.08], [0.41, 0.59]])\nassert np.allclose(P.sum(axis=1), 1.0)\npi0 = float(P[1, 0] / (P[0, 1] + P[1, 0]))\npi = np.array([pi0, 1.0 - pi0])\n"
    },
    {
      "cell_id": "11111111-1111-4111-8111-111111116003",
      "source": "steps = 350_000\nstate = int(rng.integers(0, 2))\ncounts = np.zeros(2, dtype=np.int64)\nfor _ in range(steps):\n    counts[state] += 1\n    u = rng.random()\n    if u < P[state, 1]:\n        state = 1\n    else:\n        state = 0\nemp = counts.astype(float) / float(counts.sum())\nprint('pi_closed', pi)\nprint('empirical', emp)\nprint('abs_err', np.abs(pi - emp))\n"
    }
  ]
}
