    {
      "cell_id": "3ac8f151-c041-4d3e-bb06-c2ad742c2e1f",
      "source": "from pathlib import Path\n\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\n\nroot = Path(\"benchmarks/case_studies/benchmark_robust_curve\")\ntr = pd.read_csv(root / \"train.csv\")\nho = pd.read_csv(root / \"holdout_inputs.csv\")\nprint(\"train\", tr.shape, \"holdout\", ho.shape)\nprint(\"t ranges \u2014 train:\", float(tr.t.min()), float(tr.t.max()), \"hold:\", float(ho.t.min()), float(ho.t.max()))\nprint(\"hold points outside train t span:\", int((ho.t < tr.t.min()).sum() + (ho.t > tr.t.max()).sum()))\n# residual roughness vs local linear trend\ntr = tr.sort_values(\"t\")\ndy = np.diff(tr.y_meas.values)\ndt = np.diff(tr.t.values)\nprint(\"median |dy/dt|:\", float(np.median(np.abs(dy / (dt + 1e-12)))))\n\nfig, ax = plt.subplots(figsize=(8, 3))\nax.scatter(tr.t, tr.y_meas, s=14, alpha=0.75, c=\"tab:blue\", label=\"train\")\nax.set_xlabel(\"t\")\nax.set_ylabel(\"y_meas\")\nax.legend()\nfig.tight_layout()\nfig.savefig(root / \"_explore_train.png\", dpi=130)\nprint(\"saved\", root.resolve() / \"_explore_train.png\")"
    },
    {
      "cell_id": "db9c036c-494b-4a3e-a08b-81ba9d071f88",
      "source": "from pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nfrom sklearn.base import BaseEstimator, TransformerMixin\nfrom sklearn.linear_model import HuberRegressor\nfrom sklearn.model_selection import GridSearchCV, KFold\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.preprocessing import SplineTransformer\n\nroot = Path(\"benchmarks/case_studies/benchmark_robust_curve\")\ntr = pd.read_csv(root / \"train.csv\")\nho = pd.read_csv(root / \"holdout_inputs.csv\")\n\nX = tr[[\"t\"]].values\ny = tr.y_meas.values.astype(float)\nX_ho = ho[[\"t\"]].values.astype(float)\n\n\nclass SplineFourierFeatures(BaseEstimator, TransformerMixin):\n    \"\"\"Quantile B-splines (linear extrapolation) + low-order Fourier on train-span-scaled phase.\"\"\"\n\n    def __init__(self, n_knots=18, degree=3, n_harmonics=0, knots=\"quantile\"):\n        self.n_knots = n_knots\n        self.degree = degree\n        self.n_harmonics = n_harmonics\n        self.knots = knots\n\n    def fit(self, X, y=None):\n        self.spl_ = SplineTransformer(\n            n_knots=self.n_knots,\n            degree=self.degree,\n            include_bias=True,\n            knots=self.knots,\n            extrapolation=\"linear\",\n        )\n        self.spl_.fit(X)\n        self.t0_ = float(np.min(X))\n        self.span_ = float(np.max(X) - self.t0_) + 1e-12\n        return self\n\n    def transform(self, X):\n        F = self.spl_.transform(X)\n        h = self.n_harmonics\n        if h <= 0:\n            return F\n        t = X.ravel()\n        phase = (t - self.t0_) / self.span_ * 2 * np.pi\n        blocks = [F]\n        for k in range(1, h + 1):\n            blocks.append(np.sin(k * phase)[:, None])\n            blocks.append(np.cos(k * phase)[:, None])\n        return np.hstack(blocks)\n\n\npipe = Pipeline(\n    [\n        (\"feat\", SplineFourierFeatures()),\n        (\"hub\", HuberRegressor(fit_intercept=True, max_iter=3000, tol=1e-6)),\n    ]\n)\n\nparam_grid = {\n    \"feat__n_knots\": list(range(10, 34, 2)),\n    \"feat__knots\": [\"quantile\", \"uniform\"],\n    \"feat__n_harmonics\": [0, 3, 6, 9],\n    \"hub__epsilon\": [1.1, 1.2, 1.35],\n    \"hub__alpha\": [1e-6, 1e-4, 1e-3],\n}\ncv = KFold(n_splits=5, shuffle=True, random_state=0)\nsearch = GridSearchCV(\n    pipe,\n    param_grid,\n    cv=cv,\n    scoring=\"neg_root_mean_squared_error\",\n    refit=True,\n    n_jobs=-1,\n)\nsearch.fit(X, y)\nprint(\"best_params\", search.best_params_)\nprint(\"CV_RMSE (~neg_score):\", float(-search.best_score_))\n\nbest = search.best_estimator_\ny_hat = best.predict(X_ho)\nout = pd.DataFrame({\"idx\": ho[\"idx\"].astype(int), \"y_hat\": y_hat})\nsub = root / \"submission_branchA.csv\"\nout.to_csv(sub, float_format=\"%.10f\", index=False)\nassert len(out) == 480\nprint(\"wrote\", sub.resolve(), \"rows\", len(out))"
    }
  ]
}
