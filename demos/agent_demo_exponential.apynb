  "cells": [
    {
      "cell_id": "11111111-1111-4111-8111-111111120001",
      "source": "# Deterministic comparisons for `.apynb` drift checks rely on fixing the RNG seed here.\nimport numpy as np\nrng = np.random.default_rng(53)\n"
    },
    {
      "cell_id": "11111111-1111-4111-8111-111111120002",
      "source": "# NumPy parametrization: `scale = 1/lambda` equals the mean.\nlam = 0.73\nn = 120_000\nx = rng.exponential(scale=1.0 / lam, size=n)\n"
    },
    {
      "cell_id": "11111111-1111-4111-8111-111111120003",
      "source": "sample_mean = float(x.mean())\nclosed = float(1.0 / lam)\nrel_err = abs(sample_mean - closed) / closed\nprint(\"sample_mean\", sample_mean)\nprint(\"expectation_1_over_lambda\", closed)\nprint(\"relative_error\", rel_err)\n"
    }
  ]
}
